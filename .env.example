# Database
# For local development with SQLite (simpler setup):
# DATABASE_URL="file:./dev.db"
# For PostgreSQL (production-like, use with Docker):
DATABASE_URL="postgresql://codebase_docs:codebase_docs_password@localhost:5432/codebase_docs"

# OpenAI API Key - REQUIRED
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Workspace Directory
# Where repositories will be cloned for analysis
WORKSPACE_DIR="./workspace"
